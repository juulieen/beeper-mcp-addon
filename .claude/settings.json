{
  "hooks": {
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/review-state.mjs\" stop-hook", "timeout": 20 }]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm test)",
      "Bash(npm run call:*)",
      "Bash(node scripts/review-state.mjs:*)"
    ]
  }
}
